# Storyboard model
FOUNDRY_TEXT_API_KEY=
FOUNDRY_TEXT_ENDPOINT=
FOUNDRY_TEXT_MODEL=

# Optional paid image generation (default OFF)
FOUNDRY_API_KEY=
FOUNDRY_ENDPOINT=
FOUNDRY_IMAGE_MODEL=MAI-Image-2.6-Flash
MAX_AI_IMAGES_PER_SHORT=0

# Voice
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_VOICE=en-US-BrianMultilingualNeural
