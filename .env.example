# Audio
BG_MUSIC_VOLUME=0.18

# Archive discovery and publishing quality gate
MEDIA_CACHE_DIR=.cache/media
MIN_AUTHENTIC_MEDIA_RATIO=0.30
ALLOW_PEXELS_STOCK=false
NARA_API_KEY=
