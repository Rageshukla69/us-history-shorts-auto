# Microsoft Foundry LLM (gpt-6-luna) & Image Model (MAI-Image-2.6-Flash)
FOUNDRY_TEXT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
FOUNDRY_TEXT_API_KEY=your_foundry_api_key
FOUNDRY_TEXT_MODEL=gpt-6-luna
FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
FOUNDRY_API_KEY=your_foundry_api_key
FOUNDRY_IMAGE_MODEL=MAI-Image-2.6-Flash
MAX_AI_IMAGES_PER_SHORT=10

# Azure Speech TTS (Young US Narrator)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_VOICE=en-US-BrianMultilingualNeural

# Rendering & Huashu Art Motion Integration
RENDER_ENGINE=hyperframes
HUASHU_ART_MOTION_DIR=/tmp/huashu-art-motion
DRY_RUN=true

# YouTube Data API v3 OAuth Token JSON
YOUTUBE_TOKEN_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}
